# Server Environment Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
# Provide your MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/wedding_photo_finder?retryWrites=true&w=majority)
# If omitted during local development, an automatic in-memory MongoDB instance will be used for instant testing.
MONGODB_URI=

# Authentication Secrets
# Generate a strong 64+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=super-secret-wedding-ai-jwt-token-key-2026-production
COOKIE_NAME=wedding_auth_token

# Penta Prizm Superadmin Configuration
SUPERADMIN_COOKIE_NAME=penta_superadmin_token
SUPERADMIN_EMAIL=admin@pentaprizm.com
SUPERADMIN_DEFAULT_PASSWORD=PentaPrizm2026!

# Google Drive OAuth 2.0 Credentials
# Obtain these from the Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# OAuth & Encryption Secrets
# Generate a random 32-character key for AES-256-GCM encryption of stored Drive tokens
OAUTH_STATE_SECRET=wedding-oauth-state-secret-2026-secure
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Configuration
VITE_API_BASE_URL=/api
