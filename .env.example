# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
# Public URL of the frontend. Used for post-OAuth redirects.
CLIENT_URL=http://localhost:3000
VITE_API_BASE_URL=/api

# MongoDB Atlas Database URI
# e.g. mongodb+srv://<username>:<password>@cluster0.rslozyk.mongodb.net/wedding_ai_photo_finder?retryWrites=true&w=majority
MONGODB_URI=

# JWT & Cookie Session Secrets
JWT_SECRET=dev-wedding-ai-jwt-secret-key-32-chars-long
COOKIE_NAME=wedding_auth_token
SUPERADMIN_COOKIE_NAME=penta_superadmin_token

# Fixed Platform Super Admin Configuration
SUPERADMIN_EMAIL=pentaprizmofficial@gmail.com
SUPERADMIN_DEFAULT_PASSWORD=PentaPrizm2026!

# ---------------------------------------------------------------------------
# Firebase Web App configuration — FRONTEND (PUBLIC identifiers)
# ---------------------------------------------------------------------------
# These are read by the browser through Vite's `import.meta.env` and are the
# values from your Firebase Web App configuration (Firebase Console ->
# Project settings -> General -> Your apps -> Web app -> SDK setup).
#
# The Firebase Web API key is a PUBLIC identifier, not a secret — Google
# explicitly documents it as safe to ship in client-side code. Access is
# controlled by Firebase Security Rules and by the OAuth consent screen.
#
# The service-account private key and the Google OAuth client secret are NOT
# here — they stay in the backend-only sections below.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wedding-ai-image-finder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wedding-ai-image-finder
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Authentication (Google Sign-In) — SERVER-SIDE SECRETS
# ---------------------------------------------------------------------------
# The service account authenticates the BACKEND to the Firebase Admin SDK so
# it can verify the ID tokens the browser sends. It is a private credential:
# never commit it and never expose it to the browser.
#
# OPTION A (recommended for Vercel) — the whole service account as one JSON
# blob. Download it from Firebase Console -> Project settings -> Service
# accounts -> Generate new private key, then paste the JSON here.
FIREBASE_SERVICE_ACCOUNT=

# OPTION B — the same values split into individual variables (use this for
# local development, e.g. from the downloaded service-account JSON file).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the newlines escaped as \n when pasting into a secret manager.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Google Drive OAuth 2.0 — SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# These values are read by the Express backend only. NEVER prefix them with
# `VITE_`: Vite inlines `VITE_*` variables into the public frontend bundle,
# which would leak the client secret to every visitor.
#
# Get them from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID (Application type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development callback URI.
# Register this EXACT string under "Authorized redirect URIs".
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# Production callback URI (Vercel). Used automatically when NODE_ENV=production
# or VERCEL=1. Register this EXACT string as a SECOND authorized redirect URI.
# GOOGLE_REDIRECT_URI_PRODUCTION=https://your-project.vercel.app/api/integrations/google-drive/callback

# AES-256-GCM key used to encrypt refresh tokens at rest.
# Generate with: openssl rand -hex 32
# Changing this value invalidates all previously stored refresh tokens.
TOKEN_ENCRYPTION_KEY=dev-encryption-key-wedding-drive-32-chars

# HMAC-SHA256 key used to sign the OAuth `state` parameter (CSRF protection).
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=dev-wedding-oauth-state-secret-2026

# ---------------------------------------------------------------------------
# Google Generative AI API key — SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# Used for AI-powered face matching in the public guest gallery.
# Get an API key from: https://makersuite.google.com/app/apikey
# Never expose this in frontend code — it is read by the Express backend only.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Face Recognition Configuration — SERVER-SIDE ONLY
# ---------------------------------------------------------------------------
# Maximum number of Drive images to index per event (prevents runaway indexing)
FACE_INDEX_MAX_FILES=100

# Cosine similarity threshold for face matching (0.0 to 1.0).
# Higher = stricter matching. Default 0.65 works well with face-api.js descriptors.
FACE_MATCH_THRESHOLD=0.65
