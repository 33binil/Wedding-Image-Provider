# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
VITE_API_BASE_URL=/api

# MongoDB Atlas Database URI
# e.g. mongodb+srv://<username>:<password>@cluster0.rslozyk.mongodb.net/wedding_ai_photo_finder?retryWrites=true&w=majority
MONGODB_URI=

# JWT & Cookie Session Secrets
JWT_SECRET=dev-wedding-ai-jwt-secret-key-32-chars-long
COOKIE_NAME=wedding_auth_token
SUPERADMIN_COOKIE_NAME=penta_superadmin_token

# Fixed Platform Super Admin Configuration
SUPERADMIN_EMAIL=pentaprizmofficial@gmail.com
SUPERADMIN_DEFAULT_PASSWORD=PentaPrizm2026!

# Token Encryption Secret (AES-256-GCM - must be a 32+ character random string)
TOKEN_ENCRYPTION_KEY=dev-encryption-key-wedding-drive-32-chars
OAUTH_STATE_SECRET=dev-wedding-oauth-state-secret-2026

# Google Cloud OAuth 2.0 Credentials (for Google Drive Integration)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorized Redirect URI registered in Google Cloud Console
# Local development: http://localhost:3000/api/integrations/google-drive/callback
# Vercel Production: https://<your-project>.vercel.app/api/integrations/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback